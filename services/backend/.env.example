NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/helpx?retryWrites=true&w=majority&appName=<app-name>
JWT_SECRET=replace_with_very_strong_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
COUNTDOWN_SECONDS=30
AI_SERVICE_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:5002
LOG_LEVEL=info
